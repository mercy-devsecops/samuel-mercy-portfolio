# ============================================================
# .gitignore — Samuel Mercy Oluwatobi Portfolio
# Vanilla HTML / CSS / JavaScript static site
# ============================================================

# ── NEVER COMMIT: Private keys & secrets ────────────────────
# Firebase Admin SDK service account private key
serviceAccountKey.json
*serviceAccount*.json

# Environment variable files (if added in future)
.env
.env.local
.env.*.local

# ── NEVER COMMIT: Local development / backup tools ──────────
# Data export tool (dev-only, not part of the public portfolio)
export-data.html

# Timestamped Admin data JSON backups from the export tool
SMO-portfolio-backup-*.json

# Project file backups created before Firebase integration
"Portfolio website BACKUP*/"

# ── Firebase generated files (safe to regenerate) ───────────
# Firebase project alias — no secrets, but regenerated by CLI
.firebaserc

# Firebase Hosting deploy cache
.firebase/

# ── OS metadata ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editor & IDE ────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node (if build tooling is added later) ───────────────────
node_modules/
package-lock.json
yarn.lock

# ── Test / scratch files ─────────────────────────────────────
dpi_test.html

# ============================================================
# FILES THAT ARE SAFE AND REQUIRED TO COMMIT:
#
#   index.html          — Public portfolio
#   styles.css          — Master stylesheet
#   script.js           — Public book engine
#   admin.html          — Admin Control Room
#   admin.css           — Admin styles
#   admin.js            — Admin logic
#   portfolio-config.js — Public Firebase client config
#                         (apiKey here is a public client key,
#                          not a secret — safe to commit)
#   portfolio-service.js— Shared data service layer
#   home image.png      — Local asset
# ============================================================
